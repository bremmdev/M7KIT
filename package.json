{
  "name": "@bremmdev/m7kit",
  "description": "React component library featuring less common UI components",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/bremmdev/M7KIT"
  },
  "version": "0.62.0",
  "type": "module",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js"
    },
    "./css": {
      "types": "./dist/src/css.d.ts",
      "default": "./dist/m7kit.css"
    },
    "./theme": {
      "types": "./dist/src/css.d.ts",
      "default": "./dist/theme.css"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "biome lint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "screenshots:high-contrast": "node scripts/high-contrast-screenshots.mjs",
    "test": "jest",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-links": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@storybook/testing-library": "^0.2.2",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^5.1.2",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.63.0",
    "postcss": "^8.4.33",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.1.11",
    "tailwindcss": "^4.1.14",
    "ts-jest": "^29.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.1.2"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  }
}
